@model List<Tag>
@{
    ViewData["Title"] = "Etiquetas";
}

<div class="page-head">
    <div>
        <h1 class="page-title">Etiquetas</h1>
        <p class="page-sub">Clasifica tus tareas con etiquetas reutilizables.</p>
    </div>
</div>

<section class="panel mb-section">
    <div class="panel-body">
        <form asp-action="Create" method="post" class="row g-2 align-items-end">
            @Html.AntiForgeryToken()
            <div class="col-md-4">
                <label class="form-label" for="new-tag">Nueva etiqueta</label>
                <input id="new-tag" name="name" class="form-control" required maxlength="50" />
            </div>
            <div class="col-md-2">
                <button class="btn btn-primary">Agregar</button>
            </div>
        </form>
    </div>
</section>

@if (!Model.Any())
{
    <div class="alert alert-info">Aún no tienes etiquetas.</div>
}
else
{
    <section class="panel">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Usos</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var tag in Model)
                    {
                        <tr>
                            <td>
                                <form asp-action="Edit" method="post" class="d-flex gap-2">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@tag.Id" />
                                    <input name="name" value="@tag.Name" class="form-control form-control-sm" aria-label="Nombre de la etiqueta @tag.Name" required maxlength="50" />
                                    <button class="btn btn-sm btn-outline-primary">Guardar</button>
                                </form>
                            </td>
                            <td>@tag.TaskTags.Count</td>
                            <td class="text-end">
                                <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('¿Eliminar esta etiqueta?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@tag.Id" />
                                    <button class="btn btn-sm btn-outline-danger">Eliminar</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}
