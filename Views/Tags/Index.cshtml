@model IEnumerable<PersonalKanban.Models.Tag>

@{
    ViewData["Title"] = "Gestión de Etiquetas";
}

<div class="container-fluid px-4 py-2">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="bi bi-tags-fill text-primary me-2"></i> Gestión de Etiquetas</h4>
            <p class="text-muted small mb-0">Administra las etiquetas para categorizar tus tareas.</p>
        </div>
    </div>

    <div class="row g-4">
        <!-- Create Form Column -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-body border-0 fw-bold">
                    <i class="bi bi-plus-circle me-1 text-primary"></i> Nueva Etiqueta
                </div>
                <div class="card-body">
                    <form asp-controller="Tags" asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label class="form-label fw-bold">Nombre de la Etiqueta <span class="text-danger">*</span></label>
                            <input type="text" name="name" class="form-control" placeholder="Ej. Backend, UI, SQL, Fix..." required />
                        </div>
                        <button type="submit" class="btn btn-primary btn-sm w-100">
                            <i class="bi bi-plus-lg me-1"></i> Guardar Etiqueta
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Tags List Column -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-body border-0 fw-bold">
                    <i class="bi bi-list-stars me-1 text-primary"></i> Etiquetas Existentes
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>#ID</th>
                                    <th>Etiqueta</th>
                                    <th>Tareas Asociadas</th>
                                    <th class="text-end px-4">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.Any())
                                {
                                    <tr>
                                        <td colspan="4" class="text-center text-muted py-4">No hay etiquetas registradas.</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var tag in Model)
                                    {
                                        <tr>
                                            <td class="fw-bold">#@tag.Id</td>
                                            <td>
                                                <span class="badge bg-info-subtle text-info-emphasis border fs-6">
                                                    🏷️ @tag.Name
                                                </span>
                                            </td>
                                            <td>
                                                <span class="badge bg-secondary">
                                                    @tag.TaskTags.Count tareas
                                                </span>
                                            </td>
                                            <td class="text-end px-4">
                                                <button class="btn btn-sm btn-outline-primary me-1" onclick="editTag(@tag.Id, '@tag.Name')">
                                                    <i class="bi bi-pencil"></i> Editar
                                                </button>
                                                <form asp-controller="Tags" asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('¿Eliminar esta etiqueta?');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@tag.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                                        <i class="bi bi-trash"></i> Eliminar
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Edit Tag -->
<div class="modal fade" id="editTagModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold"><i class="bi bi-pencil-square me-2"></i> Editar Etiqueta</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="Tags" asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="editTagId" name="id" />
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Nuevo Nombre</label>
                        <input type="text" id="editTagName" name="name" class="form-control" required />
                    </div>
                </div>
                <div class="modal-footer bg-body-tertiary">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar Cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function editTag(id, name) {
            document.getElementById('editTagId').value = id;
            document.getElementById('editTagName').value = name;
            const modal = new bootstrap.Modal(document.getElementById('editTagModal'));
            modal.show();
        }
    </script>
}
