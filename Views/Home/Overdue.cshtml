@model List<TaskItem>
@{
    ViewData["Title"] = "Vencidas";
}

<div class="page-head">
    <div>
        <h1 class="page-title">Tareas vencidas</h1>
        <p class="page-sub">Tareas que pasaron su fecha de vencimiento.</p>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-success">No tienes tareas vencidas.</div>
}
else
{
    <section class="panel">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Título</th>
                        <th>Estado</th>
                        <th>Prioridad</th>
                        <th>Proyecto</th>
                        <th>Venció</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var task in Model)
                    {
                        <tr>
                            <td class="text-muted">@task.Id</td>
                            <td class="fw-semibold">@task.Title</td>
                            <td>@task.Status.Name</td>
                            <td><span class="badge priority-@task.Priority.Name.ToLower()">@task.Priority.Name</span></td>
                            <td>@(task.Project?.Name ?? "—")</td>
                            <td class="text-danger">@task.DueDate?.ToString("dd/MM/yyyy HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}
