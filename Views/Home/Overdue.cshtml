@model IEnumerable<PersonalKanban.Models.TaskItem>

@{
    ViewData["Title"] = "Tareas Vencidas";
}

<div class="container-fluid px-4 py-2">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold text-danger mb-1">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> Tareas Vencidas
            </h4>
            <p class="text-muted small mb-0">Tareas que superaron su fecha límite de entrega y aún no han sido completadas.</p>
        </div>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Volver al Tablero
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 bg-body-tertiary rounded-3 border">
            <i class="bi bi-shield-check text-success display-1"></i>
            <h5 class="fw-bold mt-3">¡Todo al día!</h5>
            <p class="text-muted">No tienes ninguna tarea vencida en este momento.</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-sm mt-2">Ir al Tablero</a>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-danger">
                            <tr>
                                <th>#ID</th>
                                <th>Título</th>
                                <th>Proyecto</th>
                                <th>Prioridad</th>
                                <th>Estado Actual</th>
                                <th>Vencimiento</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var task in Model)
                            {
                                <tr>
                                    <td class="fw-bold">#@task.Id</td>
                                    <td>
                                        <a href="javascript:void(0)" onclick="openTaskDetailsModal(@task.Id)" class="fw-bold text-decoration-none">
                                            @task.Title
                                        </a>
                                    </td>
                                    <td>
                                        @if (task.Project != null)
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border">📁 @task.Project.Name</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">-</span>
                                        }
                                    </td>
                                    <td><span class="badge bg-danger">@task.Priority.Name</span></td>
                                    <td><span class="badge bg-warning text-dark">@task.Status.Name</span></td>
                                    <td class="text-danger fw-bold">
                                        <i class="bi bi-calendar-x me-1"></i> @task.DueDate?.ToString("dd/MM/yyyy HH:mm")
                                    </td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-primary" onclick="openTaskDetailsModal(@task.Id)">
                                            <i class="bi bi-eye"></i> Detalle
                                        </button>
                                        <button class="btn btn-sm btn-outline-success" onclick="openEditTaskModal(@task.Id)">
                                            <i class="bi bi-pencil"></i> Editar
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
