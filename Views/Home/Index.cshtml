@model KanbanBoardViewModel
@{
    ViewData["Title"] = "Tablero";
}

<div class="page-head">
    <div>
        <h1 class="page-title">Tablero</h1>
        <p class="page-sub">@Model.Tasks.Count tareas · arrastra las tarjetas para cambiar de estado</p>
    </div>
    <button class="btn btn-primary" data-modal-url="@Url.Action("Create", "Tasks")">Nueva tarea</button>
</div>

<form method="get" asp-action="Index" class="panel filter-bar">
    <div class="filter-field search">
        <label class="form-label" for="filter-search">Buscar</label>
        <input id="filter-search" name="SearchTerm" value="@Model.Filter.SearchTerm" class="form-control form-control-sm" placeholder="Título, descripción, proyecto, etiqueta, #id" />
    </div>
    <div class="filter-field">
        <label class="form-label" for="filter-project">Proyecto</label>
        <select id="filter-project" name="ProjectId" class="form-select form-select-sm">
            <option value="">Todos</option>
            @foreach (var project in Model.Projects)
            {
                <option value="@project.Id" selected="@(Model.Filter.ProjectId == project.Id)">@project.Name</option>
            }
        </select>
    </div>
    <div class="filter-field">
        <label class="form-label" for="filter-priority">Prioridad</label>
        <select id="filter-priority" name="PriorityId" class="form-select form-select-sm">
            <option value="">Todas</option>
            @foreach (var priority in Model.Priorities)
            {
                <option value="@priority.Id" selected="@(Model.Filter.PriorityId == priority.Id)">@priority.Name</option>
            }
        </select>
    </div>
    <div class="filter-field">
        <label class="form-label" for="filter-tag">Etiqueta</label>
        <select id="filter-tag" name="TagId" class="form-select form-select-sm">
            <option value="">Todas</option>
            @foreach (var tag in Model.Tags)
            {
                <option value="@tag.Id" selected="@(Model.Filter.TagId == tag.Id)">@tag.Name</option>
            }
        </select>
    </div>
    <div class="filter-field">
        <div class="form-check filter-check">
            <input class="form-check-input" type="checkbox" name="OnlyOverdue" value="true" id="only-overdue" checked="@Model.Filter.OnlyOverdue" />
            <label class="form-check-label" for="only-overdue">Solo vencidas</label>
        </div>
    </div>
    <div class="filter-actions">
        <button class="btn btn-sm btn-primary">Filtrar</button>
        <a class="btn btn-sm btn-secondary" asp-action="Index">Limpiar</a>
    </div>
</form>

<div class="kanban-board">
    @foreach (var status in Model.Statuses)
    {
        var tasks = Model.Tasks.Where(t => t.StatusId == status.Id).ToList();
        <section class="kanban-column" data-status-id="@status.Id">
            <header>
                <span class="column-title"><span class="status-dot" aria-hidden="true"></span>@status.Name</span>
                <span class="count-pill">@tasks.Count</span>
            </header>
            <div class="kanban-column-body">
                @foreach (var task in tasks)
                {
                    @await Html.PartialAsync("_TaskCard", task)
                }
            </div>
        </section>
    }
</div>
