@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="page-head">
    <div>
        <h1 class="page-title">Mi dashboard</h1>
        <p class="page-sub">Resumen de tus tareas y actividad.</p>
    </div>
    <a class="btn btn-secondary" asp-controller="Home" asp-action="Index">Ir al tablero</a>
</div>

<div class="stat-grid">
    <div class="stat-card">
        <span class="stat-label">Tareas</span>
        <div class="stat-value">@Model.TotalTasks</div>
    </div>
    <div class="stat-card accent-success">
        <span class="stat-label">Completadas</span>
        <div class="stat-value">@Model.CompletedTasks</div>
    </div>
    <div class="stat-card accent-danger">
        <span class="stat-label">Vencidas</span>
        <div class="stat-value">@Model.OverdueCount</div>
    </div>
</div>

<div class="content-grid three mb-section">
    <section class="panel">
        <div class="panel-head"><h2 class="panel-title">Por estado</h2></div>
        <table class="table table-sm">
            <tbody>
                @foreach (var row in Model.TasksByStatus)
                {
                    <tr><td>@row.Key</td><td class="text-end">@row.Value</td></tr>
                }
            </tbody>
        </table>
    </section>
    <section class="panel">
        <div class="panel-head"><h2 class="panel-title">Por prioridad</h2></div>
        <table class="table table-sm">
            <tbody>
                @foreach (var row in Model.TasksByPriority)
                {
                    <tr><td>@row.Key</td><td class="text-end">@row.Value</td></tr>
                }
            </tbody>
        </table>
    </section>
    <section class="panel">
        <div class="panel-head"><h2 class="panel-title">Por proyecto</h2></div>
        <table class="table table-sm">
            <tbody>
                @foreach (var row in Model.TasksByProject)
                {
                    <tr><td>@row.Key</td><td class="text-end">@row.Value</td></tr>
                }
            </tbody>
        </table>
    </section>
</div>

<div class="content-grid two">
    <section class="panel">
        <div class="panel-head"><h2 class="panel-title">Vencidas</h2></div>
        @if (!Model.OverdueTasks.Any())
        {
            <div class="panel-body text-muted small">No tienes tareas vencidas.</div>
        }
        else
        {
            <ul class="list-group list-group-flush">
                @foreach (var task in Model.OverdueTasks)
                {
                    <li class="list-group-item d-flex justify-content-between gap-3">
                        <span>#@task.Id · @task.Title</span>
                        <span class="text-danger small text-nowrap">@task.DueDate?.ToString("dd/MM/yyyy HH:mm")</span>
                    </li>
                }
            </ul>
        }
    </section>
    <section class="panel">
        <div class="panel-head"><h2 class="panel-title">Recientes</h2></div>
        <ul class="list-group list-group-flush">
            @foreach (var task in Model.RecentTasks)
            {
                <li class="list-group-item d-flex justify-content-between gap-3">
                    <span>#@task.Id · @task.Title</span>
                    <span class="badge tag-chip">@task.Status.Name</span>
                </li>
            }
        </ul>
    </section>
</div>
