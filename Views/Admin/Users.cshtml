@model List<AppUser>
@{
    ViewData["Title"] = "Usuarios";
    var adminIds = (HashSet<string>)ViewBag.AdminIds;
    var taskCounts = (Dictionary<string, int>)ViewBag.TaskCounts;
}

<div class="page-head">
    <div>
        <h1 class="page-title">Usuarios</h1>
        <p class="page-sub">Crea cuentas y revisa la actividad de cada usuario.</p>
    </div>
    <a class="btn btn-secondary" asp-action="Index">Volver al panel</a>
</div>

<section class="panel mb-section">
    <div class="panel-head"><h2 class="panel-title">Crear usuario</h2></div>
    <div class="panel-body">
        <form asp-action="CreateUser" method="post" class="row g-2 align-items-end">
            @Html.AntiForgeryToken()
            <div class="col-md-4">
                <label class="form-label" for="new-user-email">Correo</label>
                <input id="new-user-email" name="Email" type="email" class="form-control" autocomplete="email" required />
            </div>
            <div class="col-md-3">
                <label class="form-label" for="new-user-password">Contraseña</label>
                <input id="new-user-password" name="Password" type="password" class="form-control" autocomplete="new-password" required minlength="8" />
            </div>
            <div class="col-md-3">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="IsAdmin" value="true" id="is-admin" />
                    <label class="form-check-label" for="is-admin">Rol administrador</label>
                </div>
            </div>
            <div class="col-md-2">
                <button class="btn btn-primary w-100">Crear</button>
            </div>
        </form>
    </div>
</section>

<section class="panel">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Correo</th>
                    <th>Rol</th>
                    <th class="text-end">Tareas</th>
                    <th>Creado</th>
                    <th class="text-end">Contraseña</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>@user.Email</td>
                        <td>
                            @if (adminIds.Contains(user.Id))
                            {
                                <span class="badge bg-dark">Admin</span>
                            }
                            else
                            {
                                <span class="badge tag-chip">Usuario</span>
                            }
                        </td>
                        <td class="text-end">@(taskCounts.TryGetValue(user.Email ?? "", out var count) ? count : 0)</td>
                        <td class="small text-muted">@user.CreatedAt.ToString("dd/MM/yyyy")</td>
                        <td class="text-end">
                            <form asp-action="ResetPassword" method="post" class="d-inline"
                                  data-confirm="¿Restablecer la contraseña de @user.Email? Se mostrará una contraseña temporal.">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@user.Id" />
                                <button type="submit" class="btn btn-sm btn-secondary">Restablecer</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
