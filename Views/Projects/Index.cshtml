@model IEnumerable<PersonalKanban.Models.Project>

@{
    ViewData["Title"] = "Gestión de Proyectos";
}

<div class="container-fluid px-4 py-2">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="bi bi-folder-fill text-primary me-2"></i> Gestión de Proyectos</h4>
            <p class="text-muted small mb-0">Organiza tus tareas agrupándolas en proyectos específicos.</p>
        </div>
        <button type="button" class="btn btn-primary btn-sm" onclick="openCreateProjectModal()">
            <i class="bi bi-plus-lg me-1"></i> Nuevo Proyecto
        </button>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>#ID</th>
                            <th>Nombre</th>
                            <th>Descripción</th>
                            <th>Tareas Asociadas</th>
                            <th>Fecha Creación</th>
                            <th>Estado</th>
                            <th class="text-end px-4">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">No hay proyectos registrados aún.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var p in Model)
                            {
                                <tr>
                                    <td class="fw-bold">#@p.Id</td>
                                    <td class="fw-bold">📁 @p.Name</td>
                                    <td class="text-muted small">@(string.IsNullOrWhiteSpace(p.Description) ? "-" : p.Description)</td>
                                    <td>
                                        <span class="badge bg-secondary-subtle text-secondary border">
                                            @p.Tasks.Count tareas
                                        </span>
                                    </td>
                                    <td class="text-muted small">@p.CreatedAt.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        @if (p.Active)
                                        {
                                            <span class="badge bg-success-subtle text-success border">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger border">Inactivo</span>
                                        }
                                    </td>
                                    <td class="text-end px-4">
                                        <button class="btn btn-sm btn-outline-primary me-1" onclick="openEditProjectModal(@p.Id)">
                                            <i class="bi bi-pencil"></i> Editar
                                        </button>
                                        <form asp-action="ToggleActive" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@p.Id" />
                                            <button type="submit" class="btn btn-sm @(p.Active ? "btn-outline-warning" : "btn-outline-success") me-1">
                                                <i class="bi @(p.Active ? "bi-eye-slash" : "bi-eye")"></i> @(p.Active ? "Desactivar" : "Activar")
                                            </button>
                                        </form>
                                        <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('¿Eliminar o desactivar proyecto?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@p.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash"></i> Eliminar
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        async function openCreateProjectModal() {
            const res = await fetch('/Projects/Create');
            const html = await res.text();
            document.getElementById('modalContainer').innerHTML = html;
            const modal = new bootstrap.Modal(document.getElementById('projectFormModal'));
            modal.show();
        }

        async function openEditProjectModal(id) {
            const res = await fetch(`/Projects/Edit/${id}`);
            const html = await res.text();
            document.getElementById('modalContainer').innerHTML = html;
            const modal = new bootstrap.Modal(document.getElementById('projectFormModal'));
            modal.show();
        }
    </script>
}
