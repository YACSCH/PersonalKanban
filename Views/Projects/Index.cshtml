@model List<Project>
@{
    ViewData["Title"] = "Proyectos";
}

<div class="page-head">
    <div>
        <h1 class="page-title">Proyectos</h1>
        <p class="page-sub">Organiza tus tareas por proyecto.</p>
    </div>
    <button class="btn btn-primary" data-modal-url="@Url.Action("Create", "Projects")">Nuevo proyecto</button>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">Aún no tienes proyectos.</div>
}
else
{
    <section class="panel">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Descripción</th>
                        <th>Tareas</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var project in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@project.Name</td>
                            <td class="text-muted small">@project.Description</td>
                            <td>@project.Tasks.Count</td>
                            <td>
                                <span class="badge @(project.Active ? "priority-medium" : "priority-low")">
                                    @(project.Active ? "Activo" : "Inactivo")
                                </span>
                            </td>
                            <td class="text-end text-nowrap">
                                <button class="btn btn-sm btn-outline-primary" data-modal-url="@Url.Action("Edit", "Projects", new { id = project.Id })">Editar</button>
                                <form asp-action="ToggleActive" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@project.Id" />
                                    <button class="btn btn-sm btn-outline-secondary">@(project.Active ? "Desactivar" : "Activar")</button>
                                </form>
                                <form asp-action="Delete" method="post" class="d-inline" data-confirm="¿Eliminar este proyecto?">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@project.Id" />
                                    <button class="btn btn-sm btn-outline-danger">Eliminar</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}
