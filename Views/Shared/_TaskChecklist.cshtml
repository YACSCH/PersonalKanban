@model TaskItem

@if (Model != null)
{
    <div class="mb-3">
        <div class="d-flex justify-content-between align-items-center mb-1">
            <h3 class="h6 mb-0">Subtareas</h3>
            <span class="small text-muted">@Model.CompletedChecklistCount/@Model.TotalChecklistCount · @Model.ChecklistPercentage%</span>
        </div>

        <div class="progress mb-2" style="height: 6px;">
            <div class="progress-bar" style="width: @(Model.ChecklistPercentage)%"></div>
        </div>

        <ul class="list-group list-group-flush">
            @foreach (var item in Model.ChecklistItems.OrderBy(c => c.Order))
            {
                <li class="list-group-item px-0 d-flex align-items-center gap-2">
                    <input class="form-check-input mt-0" type="checkbox"
                           data-toggle-checklist="@item.Id" data-task-id="@Model.Id"
                           checked="@item.Completed" />
                    <span class="@(item.Completed ? "text-decoration-line-through text-muted" : "")">@item.Description</span>
                    <button type="button" class="btn btn-sm btn-link text-danger ms-auto py-0"
                            data-delete-checklist="@item.Id" data-task-id="@Model.Id">Quitar</button>
                </li>
            }
        </ul>

        <form asp-controller="Tasks" asp-action="AddChecklistItem" method="post"
              data-checklist-form="true" data-task-id="@Model.Id" class="input-group input-group-sm mt-2">
            @Html.AntiForgeryToken()
            <input type="hidden" name="taskId" value="@Model.Id" />
            <input name="description" class="form-control" placeholder="Nueva subtarea" required maxlength="250" />
            <button type="submit" class="btn btn-outline-secondary">Agregar</button>
        </form>
    </div>
}
