@model PersonalKanban.Models.TaskItem

@{
    var count = Model.CompletedChecklistCount;
    var total = Model.TotalChecklistCount;
    var pct = Model.ChecklistPercentage;
}

<div class="mb-3">
    <div class="d-flex justify-content-between align-items-center mb-1">
        <span class="small fw-bold text-muted">Progreso: @count / @total completadas — @pct%</span>
        <span class="badge bg-secondary">@pct%</span>
    </div>
    <div class="progress checklist-progress-bar">
        <div class="progress-bar bg-success" role="progressbar" style="width: @pct%"></div>
    </div>
</div>

<div class="list-group mb-3">
    @foreach (var item in Model.ChecklistItems)
    {
        <div class="list-group-item d-flex justify-content-between align-items-center p-2">
            <div class="form-check mb-0">
                <input class="form-check-input" type="checkbox" id="chk_@item.Id" @(item.Completed ? "checked" : "") onchange="toggleCheckitem(@item.Id, @Model.Id)" />
                <label class="form-check-label @(item.Completed ? "text-decoration-line-through text-muted" : "")" for="chk_@item.Id">
                    @item.Description
                </label>
            </div>
            <button type="button" class="btn btn-sm text-danger border-0 p-0 ms-2" onclick="deleteCheckitem(@item.Id, @Model.Id)">
                <i class="bi bi-x-circle"></i>
            </button>
        </div>
    }
</div>

<div class="input-group input-group-sm">
    <input type="text" id="newCheckitemInput" class="form-control" placeholder="Agregar subtarea..." />
    <button class="btn btn-outline-primary" type="button" onclick="submitAddChecklistItem(@Model.Id)">
        <i class="bi bi-plus-circle me-1"></i> Agregar
    </button>
</div>
