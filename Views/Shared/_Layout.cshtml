<!DOCTYPE html>
<html lang="es" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Kanban Personal</title>
    
    <!-- Bootstrap 5.3 CSS & Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Navigation Bar -->
    <nav class="navbar navbar-expand-lg border-bottom sticky-top bg-body shadow-sm">
        <div class="container-fluid px-4">
            <a class="navbar-brand fw-bold text-primary d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                <i class="bi bi-kanban-fill fs-4"></i> Kanban Personal
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-1">
                    <li class="nav-item">
                        <a class="nav-link px-3 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active fw-bold text-primary" : "")" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-grid-3x3-gap-fill me-1"></i> Tablero
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link px-3 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active fw-bold text-primary" : "")" asp-controller="Home" asp-action="Dashboard">
                            <i class="bi bi-speedometer2 me-1"></i> Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link px-3 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Overdue" ? "active fw-bold text-primary" : "")" asp-controller="Home" asp-action="Overdue">
                            <i class="bi bi-exclamation-triangle-fill me-1 text-danger"></i> Tareas Vencidas
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link px-3 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Projects" ? "active fw-bold text-primary" : "")" asp-controller="Projects" asp-action="Index">
                            <i class="bi bi-folder-fill me-1"></i> Proyectos
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link px-3 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Tags" ? "active fw-bold text-primary" : "")" asp-controller="Tags" asp-action="Index">
                            <i class="bi bi-tags-fill me-1"></i> Etiquetas
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link px-3 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Settings" ? "active fw-bold text-primary" : "")" asp-controller="Settings" asp-action="Index">
                            <i class="bi bi-gear-fill me-1"></i> Configuración
                        </a>
                    </li>
                </ul>

                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-3" onclick="openCreateTaskModal()">
                        <i class="bi bi-plus-lg me-1"></i> Nueva tarea
                    </button>
                    <button class="btn btn-outline-secondary rounded-circle" id="themeToggleBtn" title="Cambiar Modo Claro/Oscuro">
                        <i class="bi bi-moon-stars-fill text-primary" id="themeIcon"></i>
                    </button>
                </div>
            </div>
        </div>
    </nav>

    <!-- Global Alerts -->
    <div class="container-fluid px-4 mt-3">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
    </div>

    <!-- Main Content -->
    <main role="main" class="py-3">
        @RenderBody()
    </main>

    <!-- Modal Container for AJAX dialogs -->
    <div id="modalContainer"></div>

    <!-- Toast Notifications Container -->
    <div id="toastContainer" class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1090;"></div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/kanban.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
