<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Personal Kanban: tu tablero de tareas personal." />
    <title>@ViewData["Title"] - Personal Kanban</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    string Nav(string c, string a) => controller == c && action == a ? "nav-link active" : "nav-link";
    string? Current(string c, string a) => controller == c && action == a ? "page" : null;
    var displayName = User.Identity?.Name ?? "";
}
<body>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <nav class="navbar navbar-expand-xl navbar-light app-nav">
            <div class="container-fluid app-max">
                <a class="navbar-brand brand" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark" aria-hidden="true">K</span>
                    <span>Personal Kanban</span>
                </a>
                <button class="navbar-toggler" type="button" aria-label="Menú" aria-controls="main-nav" aria-expanded="false" data-bs-toggle="collapse" data-bs-target="#main-nav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="main-nav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="@Nav("Home", "Index")" aria-current="@Current("Home", "Index")" asp-controller="Home" asp-action="Index">Tablero</a></li>
                        <li class="nav-item"><a class="@Nav("Home", "Dashboard")" aria-current="@Current("Home", "Dashboard")" asp-controller="Home" asp-action="Dashboard">Dashboard</a></li>
                        <li class="nav-item"><a class="@Nav("Home", "Overdue")" aria-current="@Current("Home", "Overdue")" asp-controller="Home" asp-action="Overdue">Vencidas</a></li>
                        <li class="nav-item"><a class="@Nav("Projects", "Index")" aria-current="@Current("Projects", "Index")" asp-controller="Projects" asp-action="Index">Proyectos</a></li>
                        <li class="nav-item"><a class="@Nav("Tags", "Index")" aria-current="@Current("Tags", "Index")" asp-controller="Tags" asp-action="Index">Etiquetas</a></li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item"><a class="@Nav("Admin", "Index")" aria-current="@Current("Admin", "Index")" asp-controller="Admin" asp-action="Index">Admin</a></li>
                            <li class="nav-item"><a class="@Nav("Admin", "Users")" aria-current="@Current("Admin", "Users")" asp-controller="Admin" asp-action="Users">Usuarios</a></li>
                        }
                    </ul>
                    <div class="d-flex align-items-center gap-2 mt-3 mt-lg-0">
                        <span class="user-chip">
                            <span class="user-avatar" aria-hidden="true">@(displayName.Length > 0 ? displayName.Substring(0, 1).ToUpperInvariant() : "?")</span>
                            <span class="text-truncate" style="max-width: 180px;">@displayName</span>
                        </span>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-logout">Salir</button>
                        </form>
                    </div>
                </div>
            </div>
        </nav>
    }

    <main class="@(User.Identity?.IsAuthenticated == true ? "app-main" : "")">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" aria-label="Cerrar" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" aria-label="Cerrar" data-bs-dismiss="alert"></button>
            </div>
        }

        @RenderBody()
    </main>

    <div class="d-none" id="antiforgery">@Html.AntiForgeryToken()</div>
    <div id="modal-container"></div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/kanban.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
