@model TaskFormViewModel
@{
    var isEdit = Model.Id > 0;
    var action = isEdit ? "Edit" : "Create";
}

<div class="modal fade" id="task-modal" tabindex="-1" aria-labelledby="task-form-title">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <form asp-controller="Tasks" asp-action="@action" method="post" data-ajax-form="true">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div class="modal-header">
                    <h2 class="modal-title h5" id="task-form-title">@(isEdit ? "Editar tarea" : "Nueva tarea")</h2>
                    <button type="button" class="btn-close" aria-label="Cerrar" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label">Título</label>
                        <input asp-for="Title" class="form-control" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label">Descripción</label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-md-4">
                            <label asp-for="StatusId" class="form-label">Estado</label>
                            <select asp-for="StatusId" class="form-select" asp-items="@(new SelectList(Model.AvailableStatuses, "Id", "Name"))"></select>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="PriorityId" class="form-label">Prioridad</label>
                            <select asp-for="PriorityId" class="form-select" asp-items="@(new SelectList(Model.AvailablePriorities, "Id", "Name"))"></select>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="ProjectId" class="form-label">Proyecto</label>
                            <select asp-for="ProjectId" class="form-select">
                                <option value="">Sin proyecto</option>
                                @foreach (var project in Model.AvailableProjects)
                                {
                                    <option value="@project.Id">@project.Name</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-md-4">
                            <label asp-for="DueDate" class="form-label">Vencimiento</label>
                            <input asp-for="DueDate" type="datetime-local" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="EstimatedHours" class="form-label">Horas estimadas</label>
                            <input asp-for="EstimatedHours" type="number" step="0.25" min="0" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="WorkedHours" class="form-label">Horas trabajadas</label>
                            <input asp-for="WorkedHours" type="number" step="0.25" min="0" class="form-control" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Etiquetas</label>
                        <div class="d-flex flex-wrap gap-3">
                            @if (!Model.AvailableTags.Any())
                            {
                                <span class="text-muted small">No hay etiquetas creadas.</span>
                            }
                            @foreach (var tag in Model.AvailableTags)
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="SelectedTagIds" value="@tag.Id" id="tag-@tag.Id" checked="@Model.SelectedTagIds.Contains(tag.Id)" />
                                    <label class="form-check-label" for="tag-@tag.Id">@tag.Name</label>
                                </div>
                            }
                        </div>
                    </div>

                    @if (!isEdit)
                    {
                        <div class="mb-2">
                            <label class="form-label">Subtareas iniciales (opcional)</label>
                            <input name="NewChecklistItems" class="form-control form-control-sm mb-1" placeholder="Subtarea 1" maxlength="250" />
                            <input name="NewChecklistItems" class="form-control form-control-sm mb-1" placeholder="Subtarea 2" maxlength="250" />
                            <input name="NewChecklistItems" class="form-control form-control-sm" placeholder="Subtarea 3" maxlength="250" />
                        </div>
                    }
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>
