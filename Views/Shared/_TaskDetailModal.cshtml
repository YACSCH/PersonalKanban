@model TaskItem

<div class="modal fade" id="task-detail-modal" tabindex="-1" aria-labelledby="task-detail-title">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5" id="task-detail-title">#@Model.Id · @Model.Title</h2>
                <button type="button" class="btn-close" aria-label="Cerrar" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <div class="d-flex gap-2 mb-3">
                    <span class="badge bg-secondary">@Model.Status.Name</span>
                    <span class="badge priority-@Model.Priority.Name.ToLower()">@Model.Priority.Name</span>
                    @if (Model.Project != null)
                    {
                        <span class="badge bg-light text-dark border">@Model.Project.Name</span>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <p class="mb-3">@Model.Description</p>
                }

                <div class="row small text-muted mb-3 g-2">
                    <div class="col-md-4">Creada: @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                    <div class="col-md-4">
                        Vence:
                        @if (Model.DueDate.HasValue)
                        {
                            <span class="@(Model.IsOverdue ? "text-danger fw-semibold" : "")">@Model.DueDate.Value.ToString("dd/MM/yyyy HH:mm")</span>
                        }
                        else
                        {
                            <span>Sin fecha</span>
                        }
                    </div>
                    <div class="col-md-4">Horas: @(Model.WorkedHours ?? 0) / @(Model.EstimatedHours ?? 0)</div>
                </div>

                @if (Model.TaskTags.Any())
                {
                    <div class="mb-3 d-flex flex-wrap gap-1">
                        @foreach (var taskTag in Model.TaskTags)
                        {
                            <span class="badge bg-light text-dark border">@taskTag.Tag.Name</span>
                        }
                    </div>
                }

                <div id="checklist-container">
                    @await Html.PartialAsync("_TaskChecklist", Model)
                </div>

                <hr />

                <h3 class="h6">Comentarios</h3>
                <div id="comments-container">
                    @await Html.PartialAsync("_TaskCommentsList", Model.Comments)
                </div>

                <form asp-controller="Tasks" asp-action="AddComment" method="post" data-comment-form="true" data-task-id="@Model.Id" class="mt-2">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="taskId" value="@Model.Id" />
                    <div class="input-group input-group-sm">
                        <input name="commentText" class="form-control" placeholder="Escribe un comentario" required maxlength="1000" />
                        <button type="submit" class="btn btn-outline-secondary">Comentar</button>
                    </div>
                </form>

                <hr />

                <h3 class="h6">Historial</h3>
                @if (!Model.History.Any())
                {
                    <p class="text-muted small">Sin cambios registrados.</p>
                }
                else
                {
                    <ul class="list-unstyled small mb-0">
                        @foreach (var entry in Model.History.OrderByDescending(h => h.CreatedAt).Take(15))
                        {
                            <li class="mb-1">
                                <span class="text-muted">@entry.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                                · <strong>@entry.Action</strong>
                                @if (!string.IsNullOrWhiteSpace(entry.OldValue))
                                {
                                    <span> — @entry.OldValue → @entry.NewValue</span>
                                }
                                else if (!string.IsNullOrWhiteSpace(entry.NewValue))
                                {
                                    <span> — @entry.NewValue</span>
                                }
                            </li>
                        }
                    </ul>
                }
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                <button class="btn btn-outline-primary" data-modal-url="@Url.Action("Edit", "Tasks", new { id = Model.Id })">Editar</button>
            </div>
        </div>
    </div>
</div>
