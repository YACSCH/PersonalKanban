@model Project
@{
    var isEdit = Model.Id > 0;
    var action = isEdit ? "Edit" : "Create";
}

<div class="modal fade" id="project-modal" tabindex="-1" aria-labelledby="project-modal-title">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-controller="Projects" asp-action="@action" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div class="modal-header">
                    <h2 class="modal-title h5" id="project-modal-title">@(isEdit ? "Editar proyecto" : "Nuevo proyecto")</h2>
                    <button type="button" class="btn-close" aria-label="Cerrar" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <div asp-validation-summary="All" class="text-danger small mb-2"></div>
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">Nombre</label>
                        <input asp-for="Name" class="form-control" required maxlength="100" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label">Descripción</label>
                        <textarea asp-for="Description" class="form-control" rows="3" maxlength="500"></textarea>
                    </div>
                    <div class="form-check">
                        <input asp-for="Active" class="form-check-input" />
                        <label asp-for="Active" class="form-check-label">Activo</label>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>
