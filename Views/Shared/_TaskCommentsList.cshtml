@model IEnumerable<TaskComment>

<ul class="list-group list-group-flush">
    @if (!Model.Any())
    {
        <li class="list-group-item px-0 text-muted small">Sin comentarios.</li>
    }
    @foreach (var comment in Model)
    {
        <li class="list-group-item px-0">
            <div class="small text-muted">@comment.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
            <div>@comment.Comment</div>
        </li>
    }
</ul>
