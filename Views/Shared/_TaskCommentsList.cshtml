@model IEnumerable<PersonalKanban.Models.TaskComment>

@if (!Model.Any())
{
    <p class="text-muted small italic mb-0">No hay comentarios aún.</p>
}
else
{
    <div class="d-flex flex-column gap-2">
        @foreach (var comment in Model)
        {
            <div class="p-2 rounded bg-body-secondary border">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="fw-bold small text-primary">Comentario</span>
                    <span class="text-muted" style="font-size: 0.7rem;">@comment.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                </div>
                <div class="small" style="white-space: pre-wrap;">@comment.Comment</div>
            </div>
        }
    </div>
}
