@model TaskItem

<article class="kanban-card" draggable="true" data-task-id="@Model.Id" data-status-id="@Model.StatusId">
    <div class="card-top">
        <span class="badge priority-@Model.Priority.Name.ToLower()">@Model.Priority.Name</span>
        <span class="card-id">#@Model.Id</span>
    </div>

    <h2 class="card-title">@Model.Title</h2>

    @if (!string.IsNullOrWhiteSpace(Model.Description))
    {
        <p class="card-desc">@Model.Description</p>
    }

    @if (Model.Project != null || Model.DueDate.HasValue)
    {
        <div class="card-meta">
            @if (Model.Project != null)
            {
                <span>Proyecto · @Model.Project.Name</span>
            }
            @if (Model.DueDate.HasValue)
            {
                <span class="@(Model.IsOverdue ? "text-danger fw-semibold" : "")">Vence · @Model.DueDate.Value.ToString("dd/MM/yyyy HH:mm")</span>
            }
        </div>
    }

    @if (Model.TaskTags.Any())
    {
        <div class="mt-2 d-flex flex-wrap gap-1">
            @foreach (var taskTag in Model.TaskTags)
            {
                <span class="badge tag-chip">@taskTag.Tag.Name</span>
            }
        </div>
    }

    @if (Model.TotalChecklistCount > 0)
    {
        <div class="mt-2">
            <div class="progress" style="height: 6px;">
                <div class="progress-bar" style="width: @(Model.ChecklistPercentage)%"></div>
            </div>
            <div class="card-meta mt-1">@Model.CompletedChecklistCount/@Model.TotalChecklistCount subtareas</div>
        </div>
    }

    <div class="card-actions">
        <button class="btn btn-sm btn-outline-secondary" data-modal-url="@Url.Action("Details", "Tasks", new { id = Model.Id })">Detalle</button>
        <button class="btn btn-sm btn-outline-primary" data-modal-url="@Url.Action("Edit", "Tasks", new { id = Model.Id })">Editar</button>
        <button class="btn btn-sm btn-outline-danger" data-delete-task="@Model.Id">Eliminar</button>
    </div>
</article>
